
---
const imageSrc = "/-----/images/261012학부연구생모집.jpg";
const imageAlt = "ENPL 학부연구생 모집";
---

<div
  id="enpl-image-popup"
  class="popup-overlay"
  aria-hidden="true"
>
  <section
    class="popup-container"
    role="dialog"
    aria-modal="true"
    aria-label="ENPL 공지사항"
  >
    <button
      class="popup-close"
      type="button"
      aria-label="공지 팝업 닫기"
    >
      &times;
    </button>

    <img
      class="popup-image"
      src={imageSrc}
      alt={imageAlt}
    />
  </section>
</div>

<style>
  .popup-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.65);
  }

  .popup-overlay.is-visible {
    display: flex;
  }

  .popup-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(600px, 92vw);
    max-height: 90vh;
  }

  .popup-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .popup-close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #fff;
    color: #222;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .popup-close:hover {
    background: #eee;
  }

  @media (max-width: 600px) {
    .popup-overlay {
      padding: 12px;
    }

    .popup-container {
      max-width: 94vw;
      max-height: 88vh;
    }

    .popup-image {
      max-height: 88vh;
    }
  }
</style>

```html
<script>
  const popup = document.querySelector("#enpl-image-popup");

  if (popup) {
    const closeButton = popup.querySelector(".popup-close");
    const storageKey = "enpl-notice-dismissed-at";
    const oneDay = 24 * 60 * 60 * 1000;

    let dismissedAt = null;

    try {
      const storedValue = localStorage.getItem(storageKey);
      dismissedAt = storedValue ? Number(storedValue) : null;
    } catch {
      // If storage is unavailable, show the popup normally.
    }

    const shouldShow =
      dismissedAt === null ||
      !Number.isFinite(dismissedAt) ||
      Date.now() - dismissedAt >= oneDay ||
      Date.now() < dismissedAt;

    if (shouldShow) {
      popup.classList.add("is-visible");
      popup.setAttribute("aria-hidden", "false");
    }

    const closePopup = () => {
      popup.classList.remove("is-visible");
      popup.setAttribute("aria-hidden", "true");

      try {
        localStorage.setItem(storageKey, String(Date.now()));
      } catch {
        // The popup still closes if storage is unavailable.
      }
    };

    closeButton?.addEventListener("click", closePopup);

    popup.addEventListener("click", (event) => {
      if (event.target === popup) {
        closePopup();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        popup.classList.contains("is-visible")
      ) {
        closePopup();
      }
    });
  }
</script>
