---
interface Props {
  type?: 'pemwe' | 'aemwe' | 'electrodeposition' | 'hero' | 'person' | 'general';
  title?: string;
  subtitle?: string;
  aspectRatio?: '16/9' | '4/3' | '1/1' | '21/9';
  height?: string;
}

const { 
  type = 'general', 
  title, 
  subtitle, 
  aspectRatio = '16/9',
  height
} = Astro.props;
---

<div class={`placeholder-box type-${type}`} style={`aspect-ratio: ${aspectRatio}; ${height ? `height: ${height};` : ''}`}>
  <div class="placeholder-grid-pattern"></div>
  
  <div class="placeholder-illustration">
    {type === 'pemwe' && (
      <svg class="sci-svg" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Electrochemical Cell Frame -->
        <rect x="30" y="25" width="260" height="150" rx="4" stroke="#E0E0E0" stroke-width="2" fill="#FFFFFF"/>
        <!-- PEM Membrane -->
        <rect x="155" y="25" width="10" height="150" fill="#EE9A1A" fill-opacity="0.2" stroke="#EE9A1A" stroke-width="2"/>
        <text x="160" y="20" text-anchor="middle" font-size="10" font-weight="700" fill="#EE9A1A">PEM</text>
        
        <!-- Anode (OER) -->
        <rect x="120" y="45" width="25" height="110" fill="#222222" rx="2"/>
        <text x="132" y="105" text-anchor="middle" font-size="10" font-weight="600" fill="#FFFFFF" transform="rotate(-90 132 105)">ANODE (OER)</text>
        
        <!-- Cathode (HER) -->
        <rect x="175" y="45" width="25" height="110" fill="#222222" rx="2"/>
        <text x="187" y="105" text-anchor="middle" font-size="10" font-weight="600" fill="#FFFFFF" transform="rotate(-90 187 105)">CATHODE (HER)</text>
        
        <!-- H2O in, O2 out, H2 out -->
        <!-- OER side: H2O -> 2H+ + 1/2 O2 -->
        <circle cx="80" cy="80" r="14" fill="#FAFAFA" stroke="#E0E0E0" stroke-width="1.5"/>
        <text x="80" y="84" text-anchor="middle" font-size="10" font-weight="700" fill="#666666">H₂O</text>
        <path d="M96 80 H115" stroke="#666666" stroke-width="1.5" stroke-dasharray="3 3"/>
        
        <circle cx="80" cy="130" r="14" fill="#FFF8F0" stroke="#EE9A1A" stroke-width="1.5"/>
        <text x="80" y="134" text-anchor="middle" font-size="10" font-weight="700" fill="#EE9A1A">O₂</text>
        <path d="M115 130 H96" stroke="#EE9A1A" stroke-width="1.5"/>
        
        <!-- Proton Transport (H+) -->
        <path d="M148 100 H172" stroke="#EE9A1A" stroke-width="2" marker-end="url(#arrow)"/>
        <text x="160" y="93" text-anchor="middle" font-size="10" font-weight="800" fill="#EE9A1A">H⁺</text>
        
        <!-- HER side: 2H+ -> H2 -->
        <circle cx="240" cy="100" r="16" fill="#FFF8F0" stroke="#EE9A1A" stroke-width="2"/>
        <text x="240" y="104" text-anchor="middle" font-size="11" font-weight="800" fill="#EE9A1A">H₂</text>
        <path d="M205 100 H220" stroke="#EE9A1A" stroke-width="2"/>
      </svg>
    )}

    {type === 'aemwe' && (
      <svg class="sci-svg" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Electrochemical Cell Frame -->
        <rect x="30" y="25" width="260" height="150" rx="4" stroke="#E0E0E0" stroke-width="2" fill="#FFFFFF"/>
        <!-- AEM Membrane -->
        <rect x="155" y="25" width="10" height="150" fill="#EE9A1A" fill-opacity="0.2" stroke="#EE9A1A" stroke-width="2"/>
        <text x="160" y="20" text-anchor="middle" font-size="10" font-weight="700" fill="#EE9A1A">AEM</text>
        
        <!-- Transition Metal Electrodes (Non-precious) -->
        <rect x="120" y="45" width="25" height="110" fill="#222222" rx="2"/>
        <text x="132" y="105" text-anchor="middle" font-size="10" font-weight="600" fill="#FFFFFF" transform="rotate(-90 132 105)">Ni-Fe OER</text>
        
        <rect x="175" y="45" width="25" height="110" fill="#222222" rx="2"/>
        <text x="187" y="105" text-anchor="middle" font-size="10" font-weight="600" fill="#FFFFFF" transform="rotate(-90 187 105)">Ni-Mo HER</text>
        
        <!-- Hydroxide Ion Transport (OH-) -->
        <path d="M172 100 H148" stroke="#EE9A1A" stroke-width="2"/>
        <text x="160" y="93" text-anchor="middle" font-size="10" font-weight="800" fill="#EE9A1A">OH⁻</text>
        
        <!-- Bubbles -->
        <circle cx="80" cy="100" r="14" fill="#FFF8F0" stroke="#EE9A1A" stroke-width="1.5"/>
        <text x="80" y="104" text-anchor="middle" font-size="10" font-weight="700" fill="#EE9A1A">O₂</text>
        
        <circle cx="240" cy="100" r="16" fill="#FFF8F0" stroke="#EE9A1A" stroke-width="2"/>
        <text x="240" y="104" text-anchor="middle" font-size="11" font-weight="800" fill="#EE9A1A">H₂</text>
      </svg>
    )}

    {type === 'electrodeposition' && (
      <svg class="sci-svg" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Substrate electrode -->
        <rect x="40" y="150" width="240" height="16" fill="#222222" rx="2"/>
        <text x="160" y="162" text-anchor="middle" font-size="9" font-weight="600" fill="#FFFFFF">CONDUCTIVE SUBSTRATE</text>
        
        <!-- Nanostructure Growth / Dendrites / Pillars -->
        <path d="M60 150 V95 M80 150 V80 M100 150 V105 M120 150 V70 M140 150 V90 M160 150 V60 M180 150 V85 M200 150 V75 M220 150 V100 M240 150 V80 M260 150 V110" stroke="#EE9A1A" stroke-width="4" stroke-linecap="round"/>
        
        <!-- Metal Ions in Solution (M^n+) -->
        <circle cx="75" cy="50" r="10" stroke="#222222" stroke-width="1.5" fill="#FFFFFF"/>
        <text x="75" y="53" text-anchor="middle" font-size="8" font-weight="700" fill="#222222">Ni²⁺</text>
        <path d="M75 62 V72" stroke="#EE9A1A" stroke-width="1.5" stroke-dasharray="2 2"/>
        
        <circle cx="160" cy="35" r="10" stroke="#EE9A1A" stroke-width="1.5" fill="#FFF8F0"/>
        <text x="160" y="38" text-anchor="middle" font-size="8" font-weight="700" fill="#EE9A1A">Fe³⁺</text>
        <path d="M160 47 V53" stroke="#EE9A1A" stroke-width="1.5" stroke-dasharray="2 2"/>

        <circle cx="230" cy="45" r="10" stroke="#222222" stroke-width="1.5" fill="#FFFFFF"/>
        <text x="230" y="48" text-anchor="middle" font-size="8" font-weight="700" fill="#222222">Co²⁺</text>
        <path d="M230 57 V70" stroke="#EE9A1A" stroke-width="1.5" stroke-dasharray="2 2"/>
        
        <text x="160" y="185" text-anchor="middle" font-size="10" font-weight="700" fill="#EE9A1A">SELF-SUPPORTED 3D NANOSTRUCTURE</text>
      </svg>
    )}

    {type === 'hero' && (
      <svg class="sci-svg" viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="20" y="20" width="360" height="200" rx="4" stroke="#E0E0E0" stroke-width="1" fill="#FAFAFA"/>
        <circle cx="200" cy="120" r="60" stroke="#EE9A1A" stroke-width="1.5" stroke-dasharray="6 4" fill="none"/>
        <circle cx="200" cy="120" r="35" fill="#FFF8F0" stroke="#EE9A1A" stroke-width="2"/>
        <text x="200" y="125" text-anchor="middle" font-size="16" font-weight="800" fill="#EE9A1A">H₂ / O₂</text>
        <!-- Orbital / Interfacial Lines -->
        <line x1="80" y1="120" x2="320" y2="120" stroke="#E0E0E0" stroke-width="1.5"/>
        <line x1="200" y1="40" x2="200" y2="200" stroke="#E0E0E0" stroke-width="1.5"/>
        <rect x="70" y="110" width="20" height="20" fill="#222222"/>
        <rect x="310" y="110" width="20" height="20" fill="#222222"/>
        <text x="200" y="210" text-anchor="middle" font-size="10" font-weight="600" letter-spacing="2" fill="#666666">ENPL · ELECTROCHEMICAL RESEARCH</text>
      </svg>
    )}

    {type === 'person' && (
      <svg class="sci-svg person-svg" viewBox="0 0 160 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="80" cy="65" r="30" fill="#E0E0E0"/>
        <path d="M30 150 C30 115 52 105 80 105 C108 105 130 115 130 150" fill="#E0E0E0"/>
        <circle cx="80" cy="65" r="30" stroke="#EE9A1A" stroke-width="1.5" fill="none"/>
      </svg>
    )}

    {type === 'general' && (
      <svg class="sci-svg" viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="20" y="20" width="200" height="120" rx="4" stroke="#E0E0E0" stroke-width="1.5" fill="#FAFAFA"/>
        <circle cx="120" cy="80" r="24" stroke="#EE9A1A" stroke-width="2" fill="#FFF8F0"/>
        <path d="M110 80 H130 M120 70 V90" stroke="#EE9A1A" stroke-width="2" stroke-linecap="round"/>
      </svg>
    )}
  </div>

  {(title || subtitle) && (
    <div class="placeholder-caption">
      {title && <span class="placeholder-title">{title}</span>}
      {subtitle && <span class="placeholder-subtitle">{subtitle}</span>}
    </div>
  )}
</div>

<style>
  .placeholder-box {
    position: relative;
    width: 100%;
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1.5rem;
  }

  .placeholder-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(224, 224, 224, 0.4) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(224, 224, 224, 0.4) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .placeholder-illustration {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 380px;
  }

  .sci-svg {
    width: 100%;
    height: auto;
    max-height: 220px;
  }

  .person-svg {
    max-height: 140px;
  }

  .placeholder-caption {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .placeholder-title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .placeholder-subtitle {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>
