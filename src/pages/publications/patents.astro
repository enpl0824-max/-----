---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { patentsData } from '../../data/patents';
---

<BaseLayout 
  title="Patents | Sookil Kim Lab (ENPL)"
  description="Intellectual property and patents registered by the Energy Nano-material Process Laboratory."
>
  <section class="section section--white">
    <div class="container">
      <SectionHeader 
        category="INTELLECTUAL PROPERTY"
        title="PATENTS"
        subtitle="Patents covering advanced electrochemical electrode manufacturing processes and water electrolysis systems."
      />

      <div class="patents-list">
        {patentsData.map((patent, index) => (
          <article class="patent-item">
            <div class="patent-index">
              {String(index + 1).padStart(2, '0')}
            </div>

            <div class="patent-info">
              <h3 class="patent-title">
                {patent.link ? (
                  <a href={patent.link} target="_blank" rel="noopener noreferrer">
                    {patent.title}
                  </a>
                ) : (
                  patent.title
                )}
              </h3>

              <div class="patent-meta">
                <span>{patent.country}</span>
                <span>{patent.patentNumber}</span>
                <span class={`patent-status ${patent.status.toLowerCase()}`}>
                  ({patent.status})
                </span>
              </div>

              <div class="patent-inventors">
                {patent.inventors}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .patents-list {
    display: flex;
    flex-direction: column;
  }

  .patent-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-gray);
  }

  .patent-index {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .patent-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .patent-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .patent-title a {
    color: var(--color-text);
  }

  .patent-title a:hover {
    color: var(--color-primary);
  }

  .patent-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .patent-status {
    font-weight: 700;
  }

  .patent-status.registered {
    color: var(--color-primary);
  }

  .patent-status.pending {
    color: var(--color-text-secondary);
  }

  .patent-inventors {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .patent-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .patent-meta {
      flex-wrap: wrap;
    }
  }
</style>
