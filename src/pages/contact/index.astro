---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { labInfo } from '../../data/labInfo';
---

<BaseLayout 
  title="Contact | Sookil Kim Lab (ENPL)"
  description="Contact information and directions for Energy Nano-material Process Laboratory at Chung-Ang University."
>
  <section class="section section--white">
    <div class="container">
      <SectionHeader 
        category="GET IN TOUCH"
        title="CONTACT & LOCATION"
        subtitle="We welcome academic collaborations, industrial inquiries, and applications from prospective researchers."
      />

      <div class="contact-grid">
        <!-- Contact Information Column -->
        <div class="contact-info-col">
          <div class="info-block">
            <h3 class="info-title">LABORATORY DETAILS</h3>
            <p class="lab-name-lead">{labInfo.labFullName}</p>
            <p class="lab-affil-lead">{labInfo.department} · {labInfo.university}</p>
          </div>

          <div class="details-list">
            <div class="detail-row">
              <span class="detail-key">PROFESSOR</span>
              <span class="detail-val">{labInfo.professorName} ({labInfo.professorNameKo})</span>
            </div>

            <div class="detail-row">
              <span class="detail-key">EMAIL</span>
              <a href={`mailto:${labInfo.email}`} class="detail-val link-val">{labInfo.email}</a>
            </div>

            <div class="detail-row">
              <span class="detail-key">TELEPHONE</span>
              <span class="detail-val">{labInfo.phone}</span>
            </div>

            <div class="detail-row">
              <span class="detail-key">PROFESSOR OFFICE</span>
              <span class="detail-val">{labInfo.officeLocation} ({labInfo.officeLocationKo})</span>
            </div>

            <div class="detail-row">
              <span class="detail-key">LABORATORY</span>
              <span class="detail-val">{labInfo.labLocation} ({labInfo.labLocationKo})</span>
            </div>

            <div class="detail-row">
              <span class="detail-key">CAMPUS ADDRESS</span>
              <span class="detail-val">{labInfo.address} ({labInfo.postalCode})</span>
            </div>
          </div>

          <!-- Directions Box -->
          <div class="directions-box">
            <h4 class="directions-title">HOW TO REACH US (DIRECTIONS)</h4>
            <ul class="directions-list">
              <li>
                <strong class="subway-tag">Subway Line 9</strong>
                <span>Heukseok Station (Exit 3 or 4) — Walk approx. 10 minutes to CAU Main Gate or take town bus Dongjak 01/10.</span>
              </li>
              <li>
                <strong class="subway-tag">Subway Line 7</strong>
                <span>Sangdo Station (Exit 5) — Walk approx. 15 minutes or take town bus Dongjak 01 to CAU Back Gate.</span>
              </li>
              <li>
                <strong class="subway-tag">Campus Buildings</strong>
                <span>Building 310 (100th Anniversary Hall) is adjacent to the Main Gate. Building 202 is located across the central plaza.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Campus Map & Join Us Column -->
        <div class="contact-map-col">
          <!-- Clean Campus Map Placeholder -->
          <div class="map-card">
            <div class="map-placeholder-header">
              <span class="badge-orange">CAMPUS MAP</span>
              <span class="map-meta">Chung-Ang University Seoul Campus</span>
            </div>
            
            <div class="map-visual">
              <svg viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="map-svg">
                <!-- Background Campus Layout -->
                <rect width="400" height="240" fill="#F8FAFC"/>
                <!-- Roads / Walkways -->
                <path d="M40 210 Q 150 170 200 130 T 360 40" stroke="#E0E0E0" stroke-width="16" stroke-linecap="round"/>
                <path d="M120 220 V 60 H 280 V 220" stroke="#E0E0E0" stroke-width="8"/>
                
                <!-- Building 310 (Professor Office) -->
                <rect x="80" y="140" width="70" height="50" rx="4" fill="#222222"/>
                <text x="115" y="165" text-anchor="middle" font-size="10" font-weight="700" fill="#FFFFFF">Bldg 310</text>
                <text x="115" y="177" text-anchor="middle" font-size="8" fill="#EE9A1A">Prof. Office</text>
                <circle cx="115" cy="130" r="5" fill="#EE9A1A"/>

                <!-- Building 202 (Laboratory) -->
                <rect x="230" y="80" width="70" height="50" rx="4" fill="#222222"/>
                <text x="265" y="105" text-anchor="middle" font-size="10" font-weight="700" fill="#FFFFFF">Bldg 202</text>
                <text x="265" y="117" text-anchor="middle" font-size="8" fill="#EE9A1A">Lab 402/502</text>
                <circle cx="265" cy="70" r="5" fill="#EE9A1A"/>

                <!-- Main Gate Indicator -->
                <text x="50" y="230" font-size="9" font-weight="700" fill="#666666">MAIN GATE</text>
              </svg>
            </div>

            <div class="map-footer">
              <a 
                href="https://www.cau.ac.kr/cms/FR_CON/index.do?MENU_ID=330" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="external-map-link"
              >
                OPEN OFFICIAL CAU CAMPUS MAP <span class="arrow">→</span>
              </a>
            </div>
          </div>

          <!-- Join Our Lab Card -->
          <div class="join-card">
            <span class="badge-orange">OPPORTUNITIES</span>
            <h3 class="join-title">JOIN OUR LAB</h3>
            <p class="join-desc">
              We are actively looking for creative, enthusiastic graduate students and undergraduate researchers to join our team. If you are interested in electrochemical energy conversion, electrocatalysts, or water electrolysis, please contact Prof. Soo-Kil Kim with your CV and academic transcripts.
            </p>
            <a href={`mailto:${labInfo.email}?subject=[ENPL Lab Application] Prospective Researcher`} class="btn-primary">
              SEND EMAIL APPLICATION
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .info-title {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .lab-name-lead {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .lab-affil-lead {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
  }

  .details-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-gray);
  }

  .detail-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--color-gray);
    align-items: baseline;
  }

  .detail-key {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .detail-val {
    font-size: 0.9375rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .link-val {
    color: var(--color-primary) !important;
  }

  .directions-box {
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .directions-title {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .directions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .directions-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .subway-tag {
    color: var(--color-text);
    font-size: 0.875rem;
  }

  /* MAP & JOIN US */
  .contact-map-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .map-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .map-placeholder-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-gray);
  }

  .map-meta {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .map-visual {
    width: 100%;
    background-color: #F8FAFC;
    padding: 1rem;
  }

  .map-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-gray);
    background-color: var(--color-white);
  }

  .external-map-link {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .external-map-link:hover .arrow {
    transform: translateX(4px);
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .join-card {
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-subtle);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .join-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .join-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .detail-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
