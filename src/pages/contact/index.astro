---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout 
  title="Contact | Sookil Kim Lab (ENPL)"
  description="Contact information for Energy Nano-material Process Laboratory at Chung-Ang University."
>
  <section class="section section--white">
    <div class="container">
      <SectionHeader 
        category="GET IN TOUCH"
        title="CONTACT US"
      />

      <div class="contact-content">
        <h3>Recruitment</h3>

        <p class="intro">
          We are currently looking for talented and highly motivated graduate
          and undergraduate students who are seeking research on water
          electrolysis and fuel cell for energy conversion, and energy storage.
        </p>

        <div class="contact-details">
          <div class="contact-row">
            <span class="contact-label">Address</span>
            <span>84 Heukseok-ro, Dongjak-gu, Seoul, South Korea</span>
          </div>

          <div class="contact-row">
            <span class="contact-label">Tel</span>
            <span>+82 02-820-5770</span>
          </div>

          <div class="contact-row">
            <span class="contact-label">Fax</span>
            <span>+82 02-814-2651</span>
          </div>

          <div class="contact-row">
            <span class="contact-label">E-mail</span>
            <a href="mailto:sookilkim@cau.ac.kr">sookilkim@cau.ac.kr</a>
          </div>

          <div class="contact-row inquiry-row">
            <span class="contact-label"></span>
            <span>
              (inquiry:
              <a href="mailto:sylee6276@cau.ac.kr">sylee6276@cau.ac.kr</a>)
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .contact-content h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .intro {
    max-width: 760px;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
  }

  .contact-details {
    border-top: 1px solid var(--color-gray);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .contact-label {
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .contact-row a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .contact-row a:hover {
    text-decoration: underline;
  }

  .inquiry-row {
    border-bottom: none;
    padding-top: 0.25rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .contact-content {
      padding-top: 1rem;
    }

    .contact-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .inquiry-row {
      padding-top: 0.5rem;
    }
  }
</style>
```
