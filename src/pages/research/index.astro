---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { currentResearchTopics, previousResearchTopics, coreConcept } from '../../data/research';
import { publicationsData } from '../../data/publications';
---

<BaseLayout 
  title="Research | Sookil Kim Lab (ENPL)"
  description="Core research frontiers of Sookil Kim Lab: PEM Water Electrolysis, AEM Water Electrolysis, and Electrodeposition for electrochemical energy conversion."
>
  <!-- Page Header -->
  <section class="section section--white page-intro-section">
    <div class="container">
      <SectionHeader 
        category={coreConcept.category}
        title="ELECTROCHEMICAL ENERGY CONVERSION"
        subtitle={coreConcept.description}
      />
    </div>
  </section>

  <!-- Current Research Topics -->
  <section class="section section--gray" id="current-research">
    <div class="container">
      <div class="research-detail-list">

        <!-- 01. Hydrogen Production -->
        <article class="research-detail-card" id="hydrogen-production">
          <h2 class="detail-title">Hydrogen Production</h2>
          <p class="detail-tagline">
            Water electrolysis in both acid and base electrolytes to produce hydrogen
          </p>

          <div class="detail-image">
            <PlaceholderImage
              type="general"
              title="Hydrogen Production"
              subtitle="Water Electrolysis"
              aspectRatio="16/9"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Development of nano catalysts for water splitting</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Development of hydrogen production system</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition/sputter deposition for fabrication of non-precious catalysts</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>


        <!-- 02. Fuel Cell -->
        <article class="research-detail-card" id="fuel-cell">
          <h2 class="detail-title">Fuel Cell</h2>
          <p class="detail-tagline">
            Power generation system to convert chemical energy of fuels (H2) to electricity directly by electrochemical reaction
          </p>

          <div class="detail-image">
            <PlaceholderImage
              type="general"
              title="Fuel Cell"
              subtitle="Electrochemical Power Generation"
              aspectRatio="16/9"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Development of nano catalysts for fuel cell reaction</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition/Sputter Deposition for Fabrication of Alloy Catalyst</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Proton Exchange Membrane Fuel Cell (PEMFC)</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Direct Methanol Fuel Cell (DMFC)</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>


        <!-- 03. Electrochemical CO2 Conversion -->
        <article class="research-detail-card" id="co2-conversion">
          <h2 class="detail-title">Electrochemical CO<sub>2</sub> Conversion</h2>
          <p class="detail-tagline">
            Low temperature conversion of carbon dioxide to hydrocarbon fuel using electrochemical technology
          </p>

          <div class="detail-image">
            <PlaceholderImage
              type="general"
              title="Electrochemical CO2 Conversion"
              subtitle="CO2 Electro-reduction"
              aspectRatio="16/9"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Development of nano catalysts CO2 electro-reduction</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Development of fuel production system</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition/Sputter deposition for fabrication of non-precious catalysts</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>


        <!-- 04. Electrodeposition on 3D Nano Structure -->
        <article class="research-detail-card" id="3d-nano-structure">
          <h2 class="detail-title">Electrodeposition on 3D Nano Structure</h2>
          <p class="detail-tagline">
            Electrochemical fabrication of nano structures for electronic/storage devices
          </p>

          <div class="detail-image">
            <PlaceholderImage
              type="general"
              title="Electrodeposition on 3D Nano Structure"
              subtitle="Nano Structure Fabrication"
              aspectRatio="16/9"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Metal Electro/Electroless deposition</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>For Electronic/Storage devices</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition chemistry</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Thin film fabrication and characterization</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Previous Research Section (Small Visual Hierarchy) -->
  <section class="section section--white previous-research-section">
    <div class="container">
      <div class="previous-header">
        <span class="previous-label">HISTORICAL ARCHIVE</span>
        <h3 class="previous-title">PREVIOUS RESEARCH</h3>
        <p class="previous-intro">
          Foundational research completed in prior project phases. These topics are preserved for academic archival purposes.
        </p>
      </div>

      <div class="previous-grid">
        {previousResearchTopics.map(item => (
          <div class="previous-card">
            <h4 class="previous-card-title">{item.title}</h4>
            <span class="previous-period">{item.period}</span>
            <p class="previous-desc">{item.description}</p>
            <div class="previous-tags">
              {item.keywords.map(kw => (
                <span class="tag-subtle">{kw}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro-section {
    padding-bottom: 2rem;
  }

  .research-detail-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .research-detail-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 3.5rem;
  }

  .detail-tagline {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .content-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .block-desc {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .block-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .block-list li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .dash {
    color: var(--color-primary);
    font-weight: 700;
  }

  .related-pubs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-pub-item {
    font-size: 0.875rem;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .related-pub-year {
    color: var(--color-primary);
    font-weight: 700;
  }

  .related-pub-title {
    color: var(--color-text);
  }

  /* PREVIOUS RESEARCH (SUBTLE HIERARCHY) */
  .previous-research-section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    border-top: 1px solid var(--color-gray);
  }

  .previous-header {
    margin-bottom: 2rem;
  }

  .previous-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .previous-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text);
    margin-top: 0.25rem;
  }

  .previous-intro {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .previous-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .previous-card {
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .previous-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .previous-period {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .previous-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .previous-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .tag-subtle {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    color: var(--color-text-secondary);
    border-radius: 2px;
  }

  @media (max-width: 1024px) {
    .detail-body-grid {
      grid-template-columns: 1fr;
    }

    .detail-header {
      grid-template-columns: auto 1fr;
    }

    .detail-keywords {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .research-detail-card {
      padding: 2rem 1.5rem;
    }

    .detail-header {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .previous-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
