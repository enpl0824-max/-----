---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { coreConcept } from '../../data/research';
---

<BaseLayout 
  title="Research | Sookil Kim Lab (ENPL)"
  description="Core research frontiers of Sookil Kim Lab: PEM Water Electrolysis, AEM Water Electrolysis, and Electrodeposition for electrochemical energy conversion."
>
  <!-- Page Header -->
  <section class="section section--white page-intro-section">
    <div class="container">
      <SectionHeader 
        category={coreConcept.category}
        title="ELECTROCHEMICAL ENERGY CONVERSION"
        subtitle={coreConcept.description}
      />
    </div>
  </section>

  <!-- Current Research Topics -->
  <section class="section section--gray" id="current-research">
    <div class="container">
      <div class="research-detail-list">

        <!-- 01. Hydrogen Production -->
        <article class="research-detail-card" id="hydrogen-production">
          <h2 class="detail-title">Hydrogen Production</h2>
          <p class="detail-tagline">
            Water electrolysis in both acid and base electrolytes to produce hydrogen
          </p>

          <div class="detail-image">
            <img
              src="/-----/images/IrNi.png"
              alt="Hydrogen production"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Development of Nanocatalysts for Water Splitting</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Development of Hydrogen Production Systems</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition/Sputter Deposition for Fabrication of Non-precious Catalysts</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>


        <!-- 02. Fuel Cell -->
        <article class="research-detail-card" id="fuel-cell">
          <h2 class="detail-title">Fuel Cell</h2>
          <p class="detail-tagline">
            Power generation system that directly converts the chemical energy of fuels (H<sub>2</sub>) into electricity through electrochemical reactions
          </p>

          <div class="detail-image">
            <img
              src="/-----/images/3.%20Research_Fuel%20cell.JPG"
              alt="Fuel Cell"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Development of Nanocatalysts for Fuel Cell Reaction</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition/Sputter Deposition for Fabrication of Alloy Catalysts</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Proton Exchange Membrane Fuel Cell (PEMFC)</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Direct Methanol Fuel Cell (DMFC)</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>


        <!-- 03. Electrochemical CO<sub>2</sub> Conversion -->
        <article class="research-detail-card" id="co2-conversion">
          <h2 class="detail-title">Electrochemical CO<sub>2</sub> Conversion</h2>
          <p class="detail-tagline">
             Low-temperature conversion of carbon dioxide into hydrocarbon fuels using electrochemical technology
          </p>

          <div class="detail-image">
            <img
              src="/-----/images/AgIn.jpg"
              alt="Electrochemical CO2 Conversion"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Development of Nanocatalysts CO<sub>2</sub> Electroreduction</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Development of Fuel Production Systems</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition/Sputter Deposition for Fabrication of Non-precious Catalysts</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>


        <!-- 04. Electrodeposition on 3D Nano Structure -->
        <article class="research-detail-card" id="3d-nano-structure">
          <h2 class="detail-title">Electrodeposition on 3D Nano Structure</h2>
          <p class="detail-tagline">
            Electrochemical fabrication of nanostructures for electronic and energy storage devices
          </p>

          <div class="detail-image">
            <img
              src="/-----/images/3.%20Research_Electrodeposition%20on%203-D%20Nano%20structure.png"
              alt="Electrodeposition on 3D Nano Structure"
            />
          </div>

          <div class="content-block">
            <ul class="block-list">
              <li>
                <span class="dash">—</span>
                <span>Metal Electro/Electroless Deposition</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>For Electronic/Storage Devices</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Electrodeposition Chemistry</span>
              </li>
              <li>
                <span class="dash">—</span>
                <span>Thin Film Fabrication and Characterization</span>
              </li>
            </ul>
          </div>

          <div class="content-block">
            <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
          </div>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-intro-section {
    padding-bottom: 2rem;
  }

  .research-detail-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .research-detail-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 3rem;
  }

  .detail-image {
  width: 100%;
  height: 420px;
  margin: 2rem 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: var(--color-white);
}

.detail-image :global(img) {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

  .detail-tagline {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 900px;
  }

  .content-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .block-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .block-desc {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .block-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .block-list li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .dash {
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .research-detail-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
