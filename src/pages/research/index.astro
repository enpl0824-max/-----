---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { currentResearchTopics, previousResearchTopics, coreConcept } from '../../data/research';
import { publicationsData } from '../../data/publications';
---

<BaseLayout 
  title="Research | Sookil Kim Lab (ENPL)"
  description="Core research frontiers of Sookil Kim Lab: PEM Water Electrolysis, AEM Water Electrolysis, and Electrodeposition for electrochemical energy conversion."
>
  <!-- Page Header -->
  <section class="section section--white page-intro-section">
    <div class="container">
      <SectionHeader 
        category={coreConcept.category}
        title="ELECTROCHEMICAL ENERGY CONVERSION"
        subtitle={coreConcept.description}
      />
    </div>
  </section>

  <!-- Current Research Topics (3 Core Pillars) -->
  <section class="section section--gray" id="current-research">
    <div class="container">
      <div class="research-detail-list">
        {currentResearchTopics.map((topic, index) => {
          // Find related publications if any
          const relatedPubs = publicationsData.filter(p => 
            topic.id === 'pemwe' ? p.title.toLowerCase().includes('proton') || p.title.toLowerCase().includes('hydrogen') :
            topic.id === 'aemwe' ? p.title.toLowerCase().includes('anion') || p.title.toLowerCase().includes('catalyst') :
            p.title.toLowerCase().includes('electrodeposition') || p.title.toLowerCase().includes('structured')
          ).slice(0, 2);

          return (
            <article class="research-detail-card" id={topic.id}>
              <!-- Top Header Row -->
              <div class="detail-header">
                <span class="detail-number">{topic.number}</span>
                <div class="detail-titles">
                  <h2 class="detail-title">{topic.title}</h2>
                  <p class="detail-tagline">{topic.tagline}</p>
                </div>
                <div class="detail-keywords">
                  {topic.keywords.map(kw => (
                    <span class="badge-keyword">{kw}</span>
                  ))}
                </div>
              </div>

              <!-- Main Content Grid -->
              <div class="detail-body-grid">
                <!-- Text Column -->
                <div class="detail-text-col">
                  <div class="content-block">
                    <h3 class="block-title">RESEARCH OVERVIEW</h3>
                    <p class="block-desc">{topic.overview}</p>
                  </div>

                  {topic.keyTopics && (
                    <div class="content-block">
                      <h3 class="block-title">KEY RESEARCH TOPICS</h3>
                      <ul class="block-list">
                        {topic.keyTopics.map(item => (
                          <li>
                            <span class="dash">—</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {topic.scientificApproach && (
                    <div class="content-block">
                      <h3 class="block-title">SCIENTIFIC APPROACH</h3>
                      <ul class="block-list">
                        {topic.scientificApproach.map(item => (
                          <li>
                            <span class="dash">—</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {relatedPubs.length > 0 && (
                    <div class="content-block">
                      <h3 class="block-title">REPRESENTATIVE PUBLICATIONS</h3>
                      <div class="related-pubs">
                        {relatedPubs.map(p => (
                          <div class="related-pub-item">
                            <span class="related-pub-year">{p.year}</span>
                            <span class="related-pub-title">{p.title} (<em>{p.journal}</em>)</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                <!-- Visual Illustration Column -->
                <div class="detail-visual-col">
                  {topic.image ? (
                    <img src={topic.image} alt={topic.title} class="topic-real-image" />
                  ) : (
                    <PlaceholderImage 
                      type={topic.id as any}
                      title={topic.title}
                      subtitle={topic.shortTitle}
                      aspectRatio="4/3"
                    />
                  )}
                  <p class="figure-caption">
                    Schematic illustration of electrochemical cell architecture & interfacial kinetics for {topic.shortTitle}.
                  </p>
                </div>
              </div>

              {index < currentResearchTopics.length - 1 && <div class="topic-separator"></div>}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Previous Research Section (Small Visual Hierarchy) -->
  <section class="section section--white previous-research-section">
    <div class="container">
      <div class="previous-header">
        <span class="previous-label">HISTORICAL ARCHIVE</span>
        <h3 class="previous-title">PREVIOUS RESEARCH</h3>
        <p class="previous-intro">
          Foundational research completed in prior project phases. These topics are preserved for academic archival purposes.
        </p>
      </div>

      <div class="previous-grid">
        {previousResearchTopics.map(item => (
          <div class="previous-card">
            <h4 class="previous-card-title">{item.title}</h4>
            <span class="previous-period">{item.period}</span>
            <p class="previous-desc">{item.description}</p>
            <div class="previous-tags">
              {item.keywords.map(kw => (
                <span class="tag-subtle">{kw}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro-section {
    padding-bottom: 2rem;
  }

  .research-detail-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .research-detail-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 3.5rem;
  }

  .detail-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: flex-start;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-gray);
  }

  .detail-number {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 0.9;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .detail-titles {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .detail-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .detail-tagline {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .detail-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    max-width: 320px;
    justify-content: flex-end;
  }

  .detail-body-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: 3.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  .detail-text-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .content-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .block-desc {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .block-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .block-list li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .dash {
    color: var(--color-primary);
    font-weight: 700;
  }

  .related-pubs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-pub-item {
    font-size: 0.875rem;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .related-pub-year {
    color: var(--color-primary);
    font-weight: 700;
  }

  .related-pub-title {
    color: var(--color-text);
  }

  .detail-visual-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .figure-caption {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .topic-separator {
    display: none;
  }

  /* PREVIOUS RESEARCH (SUBTLE HIERARCHY) */
  .previous-research-section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    border-top: 1px solid var(--color-gray);
  }

  .previous-header {
    margin-bottom: 2rem;
  }

  .previous-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .previous-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text);
    margin-top: 0.25rem;
  }

  .previous-intro {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .previous-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .previous-card {
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .previous-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .previous-period {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .previous-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .previous-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .tag-subtle {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    color: var(--color-text-secondary);
    border-radius: 2px;
  }

  @media (max-width: 1024px) {
    .detail-body-grid {
      grid-template-columns: 1fr;
    }

    .detail-header {
      grid-template-columns: auto 1fr;
    }

    .detail-keywords {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .research-detail-card {
      padding: 2rem 1.5rem;
    }

    .detail-header {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .previous-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
