---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { currentResearchTopics, coreConcept } from '../data/research';
import { getSelectedPublications } from '../data/publications';
import { galleryData } from '../data/gallery';
import { labInfo } from '../data/labInfo';

const base = "/-----";
const withBase = (path: string) => base + (path.startsWith("/") ? path : `/${path}`);

const selectedPubs = getSelectedPublications();
const recentGallery = galleryData.slice(0, 3);
---

<BaseLayout title="ENPL | Energy Nano-material Process Laboratory">
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
  <div class="hero-background"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-accent-bar"></span>
        <span class="hero-badge">중앙대학교 에너지나노소재공정 연구실</span>
      </div>

      <h1 class="hero-title">
        <span class="lab-initial">E</span>nergy{' '}
        <span class="lab-initial">N</span>anomaterial{' '} 
        <span class="lab-initial">P</span>rocess{' '}
        <span class="lab-initial">L</span>ab
      </h1>

      <p class="hero-description">
        We focus on the development of electrochemical energy conversion devices of water electrolysis, CO2 conversion, and fuel cell, which are the core technologies of next-generation clean energy storage/conversion systems based on hydrogen.
        
        The research is to synthesize nano electrode materials through a variety of methods, including Electrodeposition, Sputter Deposition, and Chemical Reduction, to maximize energy conversion/storage efficiency.
        
        In addition, the manufacturing process of these nanomaterials can extend its application by grafting them into various fields such as thin films, catalysts, and electronic materials.
      </p>

      <div class="hero-keywords">
        <span class="badge-keyword">PEMWE</span>
        <span class="keyword-dot">·</span>
        <span class="badge-keyword">AEMWE</span>
        <span class="keyword-dot">·</span>
        <span class="badge-keyword">HER / OER</span>
        <span class="keyword-dot">·</span>
        <span class="badge-keyword">ELECTROCATALYSTS</span>
        <span class="keyword-dot">·</span>
        <span class="badge-keyword">ELECTRODEPOSITION</span>
      </div>

      <div class="hero-cta-group">
        <a href={withBase("/research/")} class="btn-primary">EXPLORE RESEARCH</a>
        <a href={withBase("/publications/papers/")} class="btn-secondary">PUBLICATIONS</a>
      </div>
    </div>
  </div>
</section>

  <!-- 2. RESEARCH TOPICS (EDITORIAL NUMBERED LAYOUT) -->
  <section class="section section--gray" id="research-topics">
    <div class="container">
      <SectionHeader 
        category="CORE FOCUS"
        title="RESEARCH TOPICS"
        subtitle="Our research focuses on electrochemical energy conversion and nanomaterial processing"
      />

<div class="research-topic-grid">
  <a href={withBase("/research/")} class="research-topic-card">
    <span class="topic-number">01</span>
    <h3>Hydrogen production</h3>
    <span class="topic-arrow">→</span>
  </a>

  <a href={withBase("/research/")} class="research-topic-card">
    <span class="topic-number">02</span>
    <h3>Fuel cell</h3>
    <span class="topic-arrow">→</span>
  </a>

  <a href={withBase("/research/")} class="research-topic-card">
    <span class="topic-number">03</span>
    <h3>Electrochemical CO2 conversion</h3>
    <span class="topic-arrow">→</span>
  </a>

  <a href={withBase("/research/")} class="research-topic-card">
    <span class="topic-number">04</span>
    <h3>Electrodeposition on 3D Nano structure</h3>
    <span class="topic-arrow">→</span>
  </a>
</div>
    </div>
  </section>

  <!-- 3. SELECTED PUBLICATIONS (CLEAN LIST FORMAT) -->
  <section class="section section--white" id="selected-publications">
    <div class="container">
      <div class="section-title-row">
        <SectionHeader 
          category="ACADEMIC OUTCOMES"
          title="SELECTED PUBLICATIONS"
          subtitle="Representative journal papers highlighting our latest research breakthroughs."
        />
        <a href={withBase("/publications/papers/")} class="view-all-link">
          VIEW ALL PAPERS <span class="arrow">→</span>
        </a>
      </div>

      <div class="pub-clean-list">
        {selectedPubs.map((pub) => (
          <div class="pub-row">
            <div class="pub-year-col">
              <span class="pub-year">{pub.year}</span>
            </div>
            <div class="pub-info-col">
              <h4 class="pub-title">
                <a href={pub.link || "#"} target="_blank" rel="noopener noreferrer">
                  {pub.title}
                </a>
              </h4>
              <p class="pub-authors">{pub.authors}</p>
              <p class="pub-journal">
                <em>{pub.journal}</em>
                {pub.volume && `, Vol. ${pub.volume}`}
                {pub.doi && <span class="pub-doi"> · DOI: {pub.doi}</span>}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. GALLERY / LAB HIGHLIGHTS -->
  <section class="section section--gray" id="lab-highlights">
    <div class="container">
      <div class="section-title-row">
        <SectionHeader 
          category="ACTIVITIES & LIFE"
          title="LAB HIGHLIGHTS"
          subtitle="Moments of academic discovery, symposiums, and group collaborations."
        />
        <a href={withBase("/gallery/")} class="view-all-link">
          FULL GALLERY <span class="arrow">→</span>
        </a>
      </div>

      <div class="gallery-preview-grid">
        {recentGallery.map((item) => (
          <div class="gallery-preview-card">
            <div class="card-visual">
              <img 
                src={item.images[0]} 
                alt={item.title}
                class="gallery-highlight-image"
              />
            </div>
            <div class="card-caption">
              <div class="caption-meta">
                <span class="badge-orange">{item.category}</span>
                <span class="caption-date">{item.date}</span>
              </div>
              <h4 class="caption-title">{item.title}</h4>
              <p class="caption-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. CONTACT / JOIN OUR LAB -->
  <section class="section section--white" id="join-us">
    <div class="container">
      <div class="contact-cta-box">
        <div class="cta-text-col">
          <span class="badge-orange">OPPORTUNITIES</span>
          <h2 class="cta-title">JOIN OUR RESEARCH GROUP</h2>
          <p class="cta-desc">
            We are consistently seeking passionate and motivated graduate students (M.S., Ph.D., Integrated) 
            and undergraduate researchers interested in electrochemical energy conversion, electrocatalyst synthesis, 
            and water electrolysis technologies.
          </p>
          <div class="cta-contact-details">
            <p><strong>Principal Investigator:</strong> {labInfo.professorName} ({labInfo.email})</p>
            <p><strong>Location:</strong> {labInfo.officeLocation} & {labInfo.labLocation}, {labInfo.university}</p>
          </div>
        </div>
        <div class="cta-action-col">
          <a href={withBase("/contact/")} class="btn-primary">CONTACT & DIRECTIONS</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO STYLES */
.hero-section {
  position: relative;
  min-height: 620px;
  padding-top: 6rem;
  padding-bottom: 6rem;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.hero-background {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.82),
      rgba(255, 255, 255, 0.82)
    ),
    url('/-----/images/hero-background.jpg');
  background-size: cover;
  background-position: center;
  z-index: 0;
}

.hero-container {
  position: relative;
  z-index: 1;
  width: 100%;
}

.hero-content {
  max-width: 900px;
}

  .hero-badge-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-accent-bar {
    width: 32px;
    height: 3px;
    background-color: var(--color-primary);
  }

  .hero-badge {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1.75rem;
  }

  .text-highlight {
    color: var(--color-primary);
  }

  .lab-initial {
    color: var(--color-primary);
    font-weight: 900;
  }

  .hero-description {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 auto 2rem;
    max-width: 850px;
    width: 100%;
  }

  .hero-keywords {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .keyword-dot {
    color: var(--color-primary);
    font-weight: bold;
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

 /* RESEARCH TOPICS */
  .research-topic-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
 }

  .research-topic-card {
    position: relative;
    min-height: 180px;
    padding: 2rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .research-topic-card .topic-number {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .research-topic-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0;
  }

  .research-topic-card .topic-arrow {
    position: absolute;
    right: 2rem;
    top: 2rem;
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  /* SELECTED PUBLICATIONS */
  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .view-all-link {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 3.5rem;
  }

  .view-all-link:hover .arrow {
    transform: translateX(4px);
  }

  .pub-clean-list {
    display: flex;
    flex-direction: column;
  }

  .pub-row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 2rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-gray);
    align-items: baseline;
  }

  .pub-year {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .pub-info-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pub-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .pub-title a {
    color: var(--color-text);
  }

  .pub-title a:hover {
    color: var(--color-primary);
  }

  .pub-authors {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .pub-journal {
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .pub-doi {
    color: var(--color-text-secondary);
  }

  /* GALLERY PREVIEW */
  .gallery-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

.gallery-highlight-image {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  display: block;
}

  .gallery-preview-card {
    background-color: var(--color-white);
    border: 1px solid #d4d4d4;
    border-radius: var(--radius-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .gallery-preview-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .card-caption {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .caption-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .caption-date {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .caption-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .caption-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* CONTACT / RECRUITMENT CTA BOX */
  .contact-cta-box {
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-subtle);
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }

  .cta-text-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cta-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    max-width: 720px;
  }

  .cta-contact-details {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .topic-grid {
      grid-template-columns: 1fr 1fr;
    }

    .topic-visual-col {
      grid-column: 1 / -1;
    }

    .gallery-preview-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .topic-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .pub-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .gallery-preview-grid {
      grid-template-columns: 1fr;
    }

    .contact-cta-box {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2rem;
    }
  }
</style>
