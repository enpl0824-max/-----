---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { alumniData } from '../../data/alumni';

// Group alumni by graduation year descending
const alumniByYear = alumniData.reduce((acc, item) => {
  if (!acc[item.graduationYear]) acc[item.graduationYear] = [];
  acc[item.graduationYear].push(item);
  return acc;
}, {} as Record<number, typeof alumniData>);

const years = Object.keys(alumniByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout 
  title="Alumni | Sookil Kim Lab (ENPL)"
  description="Former members and graduates of Energy Nano-material Process Laboratory."
>
  <section class="section section--white">
    <div class="container">
      <SectionHeader 
        category="COMMUNITY"
        title="ALUMNI"
        subtitle="Recognizing our distinguished graduates who have advanced into leading academic institutes, national laboratories, and global energy industries."
      />

      <div class="alumni-table-container">
        {years.map((year) => (
          <div class="year-block">
            <div class="year-heading">
              <span class="year-number">{year}</span>
              <span class="year-line"></span>
            </div>

            <div class="alumni-list">
              {alumniByYear[year].map((alumnus) => (
                <div class="alumnus-card">
                  <div class="alumnus-primary">
                    <h3 class="alumnus-name">
                      {alumnus.name}
                      {alumnus.nameKo && <span class="alumnus-name-ko">({alumnus.nameKo})</span>}
                    </h3>
                    <span class="badge-orange">{alumnus.degree}</span>
                  </div>

                  <div class="alumnus-details">
                    <div class="detail-item">
                      <span class="detail-label">CURRENT AFFILIATION</span>
                      <span class="detail-value">{alumnus.currentAffiliation}</span>
                    </div>
                    <div class="detail-item">
                      <span class="detail-label">RESEARCH AREA</span>
                      <span class="detail-value">{alumnus.researchArea}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .alumni-table-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .year-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .year-heading {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .year-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .year-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-gray);
  }

  .alumni-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .alumnus-card {
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }

  .alumnus-card:hover {
    border-color: var(--color-primary);
  }

  .alumnus-primary {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .alumnus-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .alumnus-name-ko {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .alumnus-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .detail-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .detail-value {
    font-size: 0.875rem;
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .alumni-list {
      grid-template-columns: 1fr;
    }

    .alumnus-details {
      grid-template-columns: 1fr;
    }
  }
</style>
