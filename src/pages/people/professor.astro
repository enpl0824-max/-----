---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { professorData } from '../../data/professor';
---

<BaseLayout 
  title="Professor | Sookil Kim Lab (ENPL)"
  description="Profile of Prof. Soo-Kil Kim, Principal Investigator of Energy Nano-material Process Laboratory at Chung-Ang University."
>
  <section class="section section--white">
    <div class="container">
      <SectionHeader 
        category="PRINCIPAL INVESTIGATOR"
        title="PROFESSOR"
        subtitle="Leading research in electrochemical energy materials and advanced water electrolysis systems."
      />

      <div class="professor-profile-wrapper">
        <!-- Top Profile Card -->
        <div class="prof-top-card">
          <div class="prof-photo-col">
            {professorData.photo ? (
              <img src={professorData.photo} alt={professorData.name} class="prof-real-photo" />
            ) : (
              <PlaceholderImage 
                type="person" 
                title="Prof. Soo-Kil Kim"
                subtitle="Principal Investigator"
                aspectRatio="1/1"
              />
            )}
          </div>

          <div class="prof-intro-col">
            <div class="prof-identity">
              <span class="prof-title-badge">{professorData.position}</span>
              <h1 class="prof-name">{professorData.name} <span class="prof-name-ko">({professorData.nameKo})</span></h1>
              <p class="prof-affil">{professorData.department} · {professorData.university}</p>
            </div>

            <div class="prof-contact-box">
              <div class="contact-item">
                <span class="label">EMAIL</span>
                <a href={`mailto:${professorData.email}`} class="value email-link">{professorData.email}</a>
              </div>
              <div class="contact-item">
                <span class="label">PHONE</span>
                <span class="value">{professorData.phone}</span>
              </div>
              <div class="contact-item">
                <span class="label">OFFICE</span>
                <span class="value">{professorData.office}</span>
              </div>
            </div>

            <div class="prof-interests">
              <span class="interests-label">RESEARCH INTERESTS</span>
              <div class="interest-tags">
                {professorData.researchInterests.map(interest => (
                  <span class="badge-keyword">{interest}</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Career & Education Section -->
        <div class="prof-details-grid">
          <!-- Experience Column -->
          <div class="detail-column">
            <h3 class="column-title">ACADEMIC & PROFESSIONAL EXPERIENCE</h3>
            <div class="timeline-list">
              {professorData.experience.map(exp => (
                <div class="timeline-item">
                  <span class="timeline-period">{exp.period}</span>
                  <div class="timeline-content">
                    <strong class="timeline-role">{exp.role}</strong>
                    <span class="timeline-inst">{exp.institution}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Education Column -->
          <div class="detail-column">
            <h3 class="column-title">EDUCATION</h3>
            <div class="timeline-list">
              {professorData.education.map(edu => (
                <div class="timeline-item">
                  <span class="timeline-period">{edu.degree}</span>
                  <div class="timeline-content">
                    <strong class="timeline-role">
                      {edu.institution} ({edu.field})
                    </strong>
                    {edu.year && <span class="timeline-inst">{edu.year}</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .professor-profile-wrapper {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .prof-top-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
    align-items: start;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-gray);
  }

  .prof-photo-col {
    width: 100%;
    max-width: 280px;
  }

  .prof-real-photo {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: var(--radius-subtle);
    border: 1px solid var(--color-gray);
  }

  .prof-intro-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .prof-title-badge {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .prof-name {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--color-text);
    margin-top: 0.25rem;
    letter-spacing: -0.02em;
  }

  .prof-name-ko {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .prof-affil {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }

  .prof-contact-box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 1.5rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-item .label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .contact-item .value {
    font-size: 0.9375rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .email-link {
    color: var(--color-primary) !important;
  }

  .prof-interests {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .interests-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .interest-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* DETAILS GRID */
  .prof-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
  }

  .detail-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .column-title {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    text-transform: uppercase;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-gray);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }

  .timeline-period {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .timeline-role {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .timeline-inst {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* ACTIVITIES */
  .activities-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: #FAFAFA;
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-subtle);
    padding: 2rem;
  }

  .activities-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .activities-list li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .bullet-dash {
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .prof-top-card {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .prof-contact-box {
      grid-template-columns: 1fr;
    }

    .prof-details-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
